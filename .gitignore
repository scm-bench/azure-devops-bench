# Build output. These patterns are anchored to the repository root on purpose:
# an unanchored "azure-devops-bench" also matches the cmd/azure-devops-bench/ source
# directory, which silently excludes the main package from the repository.
/bin/
/dist/
/azure-devops-bench
/azure-devops-bench.exe

# Test and coverage output
coverage.out
coverage.html

# Captured snapshots and reports describe a real organization's weak points.
# Keeping them out of git by default avoids publishing them by accident.
*.snapshot.json
snapshot.json
report.json
report.sarif

# The bundled sample is synthetic and is meant to be committed: it is what
# `azure-devops-bench scan --snapshot-in examples/snapshot.json` runs against.
!examples/snapshot.json

# Local configuration
azure-devops-bench.local.yaml

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# The recon probe saves raw API responses from a real organization here.
# They are scrubbed of credentials, but they still name its projects,
# repositories, groups and people.
/hack/recon/out/
